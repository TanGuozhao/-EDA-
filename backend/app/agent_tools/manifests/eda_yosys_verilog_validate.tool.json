{
  "tool_id": "eda.yosys_verilog_validate",
  "name": "Yosys Verilog Validate",
  "version": "0.1.0",
  "description": "Validate submitted Verilog code through the backend-controlled Yosys wrapper.",
  "allowed_agents": [
    "default-agent"
  ],
  "allowed_skills": [],
  "input_schema": {
    "type": "object",
    "required": [
      "verilog_code"
    ],
    "properties": {
      "verilog_code": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200000
      },
      "top_module": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "valid",
      "status",
      "parser",
      "hierarchy",
      "synthesis",
      "diagnostics"
    ],
    "properties": {
      "valid": {
        "type": "boolean"
      },
      "status": {
        "type": "string"
      },
      "parser": {
        "type": "object"
      },
      "hierarchy": {
        "type": "object"
      },
      "synthesis": {
        "type": "object"
      },
      "diagnostics": {
        "type": "array"
      }
    },
    "additionalProperties": true
  },
  "timeout_seconds": 20,
  "max_output_chars": 20000,
  "requires_login": true,
  "risk_level": "medium",
  "visibility": "internal",
  "audit_version": "2026-08-03",
  "owner": "backend",
  "enabled": true
}
