DATABASE_URL=mysql+pymysql://root:password@localhost:3306/eda_platform
LLM_PROVIDER=local-openai-compatible
LLM_BASE_URL=http://127.0.0.1:6006/v1
LLM_API_KEY=<your-openai-compatible-api-key>
LLM_MODEL=qwen2.5-7b-eda
LLM_TIMEOUT_SECONDS=60
LLM_GATEWAY_API_KEY=<optional-local-gateway-api-key>
CORS_ALLOW_ORIGINS=http://localhost:5173
YOSYS_EXECUTABLE=backend/third_party/eda_tools/yosys/yosys.exe
YOSYS_TIMEOUT_SECONDS=20
EDA_TOOL_WORK_ROOT=/var/cache/chip-platform/eda-tools
GENERATED_TIMING_DAGS_DIR=/var/lib/chip-platform/generated_timing_dags
